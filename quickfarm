}

-- Safely unpack values to find the actual underlying Instance
local function ResolveToInstance(val)
    if typeof(val) == "Instance" then
        return val
    elseif type(val) == "table" then
        for _, item in pairs(val) do
            local resolved = ResolveToInstance(item)
            if resolved then
                return resolved
            end
        end
    end
    return nil
end

-- Defensive debug environment extraction
local debug_getupvalue = (debug and debug.getupvalue) or getupvalue
local debug_setupvalue = debug.setupvalue or (debug and debug.setupvalue) or setupvalue

-- Globally cached environment states
local CachedUpdGameState = nil
local CachedEscapeLockIndices = {}

local function GetGameScriptState()
    local env = CLMAINenv or getsenv(CLMAIN)
    local updGameState = env and env.updGameState
    if not updGameState or not debug_getupvalue then return nil, nil end

    local booleanIndices = {}
    -- Scan up to 150 upvalues dynamically to find boolean states
    for i = 1, 150 do
        local success, name, val = pcall(function() return debug_getupvalue(updGameState, i) end)
        if not success or not name then break end
        
        -- Collect all boolean upvalues to bypass the "v29" lock dynamically
        if type(val) == "boolean" then
            table.insert(booleanIndices, i)
        end
    end
    return updGameState, booleanIndices
end

local function CacheGameScriptState()
    VerifyIntegrity()
    local updGameState, booleanIndices = GetGameScriptState()
    if updGameState then
        CachedUpdGameState = updGameState
        CachedEscapeLockIndices = booleanIndices
    end
end


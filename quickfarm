-- ==============================================================================
-- [AUTO-CHALLENGE SYSTEM LOGIC]
-- ==============================================================================

local IMPOSSIBLE_PATTERNS = {
    "slide under",
    "walljump",
    "zipline",
    "without pressing",
    "air bubble",
    "regenerate air",
    "vote multiple times",
    "exploding button"
}

local PlayerCoins = 0
local ActiveChallenges = nil

TrackConnection(UpdPlayerData.OnClientEvent:Connect(function(p1)
    if p1 then
        if p1.dailyChallenges then
            ActiveChallenges = p1.dailyChallenges
        end
        if p1.stats and p1.stats.coins then
            PlayerCoins = p1.stats.coins
        end
    end
end))

task.spawn(function()
    local lastCycleTime = 0
    while true do
        task.wait(2)
        if _G.LoopCancel == true then break end
        
        if UI_State.AutoChallenge and ActiveChallenges then
            local standardList = ActiveChallenges.standard or {}
            local masterList = ActiveChallenges.master or {}
            
            local incompleteStandards = {}
            local incompleteMasters = {}
            
            -- 1. Gather all incomplete standard challenges
            for _, chal in pairs(standardList) do
                local isCompleted = chal.completed == true or (chal.amtCurrent >= chal.amtRequired)
                if not isCompleted then
                    table.insert(incompleteStandards, chal)
                end
            end
            
            -- 2. Gather all incomplete master challenges
            for _, chal in pairs(masterList) do
                local isCompleted = chal.completed == true or (chal.amtCurrent >= chal.amtRequired)
                if not isCompleted then
                    table.insert(incompleteMasters, chal)
                end
            end
            
            local totalIncomplete = #incompleteStandards + #incompleteMasters
            
            if totalIncomplete > 0 then
                -- 3. Evaluate standard challenges for impossibility
                local standardImpossibleCount = 0
                for _, chal in ipairs(incompleteStandards) do
                    local descLower = chal.desc:lower()
                    
                    -- Check Roblox Premium limitation
                    local isPremiumLocked = (chal.isPremium == true) and (LocalPlayer.MembershipType ~= Enum.MembershipType.Premium)
                    local isImpossible = isPremiumLocked
                    
                    if not isImpossible then
                        for _, pattern in ipairs(IMPOSSIBLE_PATTERNS) do
                            if descLower:find(pattern) then
                                isImpossible = true
                                break
                            end
                        end
                    end
                    
                    if isImpossible then
                        standardImpossibleCount = standardImpossibleCount + 1
                    end
                end
                
                local allStandardsAreImpossible = (#incompleteStandards > 0) and (standardImpossibleCount == #incompleteStandards)
                
                -- 4. Evaluate master challenges for impossibility
                local masterImpossibleCount = 0
                for _, chal in ipairs(incompleteMasters) do
                    local descLower = chal.desc:lower()
                    
                    -- Check Roblox Premium limitation
                    local isPremiumLocked = (chal.isPremium == true) and (LocalPlayer.MembershipType ~= Enum.MembershipType.Premium)
                    local isImpossible = isPremiumLocked
                    
                    if not isImpossible then
                        -- Direct match check
                        for _, pattern in ipairs(IMPOSSIBLE_PATTERNS) do
                            if descLower:find(pattern) then
                                isImpossible = true
                                break
                            end
                        end
                        
                        -- Dependency check: If it relies on standard challenges, but all standards are deadlocked/impossible
                        if not isImpossible and descLower:find("standard challenges") then
                            if allStandardsAreImpossible or #incompleteStandards == 0 then
                                isImpossible = true
                            end
                        end
                    end
                    
                    if isImpossible then
                        masterImpossibleCount = masterImpossibleCount + 1
                    end
                end
                
                -- 5. Calculate global impossibility
                local totalImpossible = standardImpossibleCount + masterImpossibleCount
                
                if totalImpossible == totalIncomplete then
                    local now = os.time()
                    if now - lastCycleTime >= 10 then
                        if PlayerCoins >= 50 then
                            local CycleRemote = RemoteFolder:FindFirstChild("CycleNewChallenges")
                            if CycleRemote then
                                pcall(function()
                                    CycleRemote:FireServer()
                                    Alert("All active challenges are impossible or deadlocked. Cycling...", "Warning")
                                end)
                                lastCycleTime = now
                            end
                        else
                            Alert("Cannot cycle challenges: Insufficient coins (needs 50).", "Error")
                            -- Prevent printing on every single tick
                            lastCycleTime = now + 10 
                        end
                    end
                end
            end
        end
    end
end)

local function OnMapLoad(Map)
    VerifyIntegrity()
    CurrentlyFarming = true
    CurrentGoal = nil
    CurrentButton = nil
    NextGoal = nil
    Escaped = false
    ExitPhaseActive = false -- Explicitly disabled at map start
    local alternate = false
    
    -- Safety timers for softlocks
    local escapeTimer = nil
    local buttonStuckTimer = nil
    local lastButtonInstance = nil

    -- Cache upvalue indexes once at map load
    CacheGameScriptState()

    local Settings = Map:WaitForChild("Settings", 10)
    local MapName = Settings and Settings:GetAttribute("MapName") or Map.Name
    
    if Settings then
        if MapName then 
            Alert("Map Detected: " .. MapName .. ". Loading farm settings!", "Info") 
        end
    end

    -- Process Difficulty Limiter Check
    if UI_State.EnforceDifficulty then
        local mapDiff = GetCurrentMapDifficulty()
        local currentRank = DIFFICULTY_RANKS[mapDiff] or 0
        local targetRank = DIFFICULTY_RANKS[UI_State.TargetDifficulty] or 999
        
        if currentRank > targetRank then
            Alert("Map is too difficult (" .. tostring(mapDiff) .. "). Skipping...", "Error")
            ResettingForDifficulty = true
            task.wait(0.5)
            local char = GetChar()
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.Health = 0
            end
            CurrentlyFarming = false
            return
        end
    end
    
    if Check("InGame") == false then
        Alert("Waiting for the match to start...", "Warning")
    end

    local Humanoid = GetChar():WaitForChild("Humanoid")
    
    -- Manage the GodMode connection defensively to prevent stacking memory leaks
    if CurrentGodModeConnection then
        CurrentGodModeConnection:Disconnect()
        CurrentGodModeConnection = nil
    end

    CurrentGodModeConnection = Humanoid:GetPropertyChangedSignal("Health"):Connect(function()
        if UI_State.GodModeActive and Humanoid.Health < 1000 then
            Humanoid.Health = 1000
        end
    end)
    TrackConnection(CurrentGodModeConnection)
    
    local HRP = GetChar():WaitForChild("HumanoidRootPart", 10)
    
    -- Wait until deployed in-game and unanchored before taking action
    while (not Check("InGame") or HRP.Anchored) and getgenv().TomatoAutoFarm and UI_State.FarmActive do
        task.wait()
    end
    
    local spawnCFrame = HRP and HRP.CFrame
    
    -- Auto Collect Items via Direct Teleportation (1-frame duration)
    local LostPage = Map:FindFirstChild("_LostPage", true)
    local Rescue = Map:FindFirstChild("_Rescue", true)
    
    if LostPage and HRP then
        HRP.CFrame = CFrame.new(LostPage.Position)
        task.wait()
        HRP.CFrame = spawnCFrame
        Alert("Hidden Page Acquired.", "Item")
    end
    
    if Rescue and HRP then
        local contact = Rescue:FindFirstChild("Contact", true) or Rescue:FindFirstChildWhichIsA("BasePart", true)
        if contact then
            HRP.CFrame = CFrame.new(contact.Position)
            task.wait()
            HRP.CFrame = spawnCFrame
            Alert("Survivor Rescued.", "Item")
        end
    end
    
    SetNoclip(true)
    Alert("Farming started! Navigating targets.", "Success")

    while RunService.Heartbeat:Wait() and Check("InGame") and getgenv().TomatoAutoFarm and UI_State.FarmActive and not Escaped do
        if not CurrentlyFarming or Escaped or not UI_State.FarmActive then break end

        local Hum = GetChar():FindFirstChildOfClass("Humanoid")
        if not HRP or not Hum then continue end

        local activeButton = ResolveToInstance(CurrentButton)
        local activeNextButton = ResolveToInstance(NextGoal)

        local isButtonToPress = false
        if activeButton and activeButton:IsA("BasePart") then
            local nameLower = activeButton.Name:lower()
            if not nameLower:find("exit") and not nameLower:find("region") then
                isButtonToPress = true
            end
        end

        local isNextButtonToPress = false
        if activeNextButton and activeNextButton:IsA("BasePart") then
            local nameLower = activeNextButton.Name:lower()
            if not nameLower:find("exit") and not nameLower:find("region") then
                isNextButtonToPress = true
            end
        end

        local targetPart = nil
        if isButtonToPress and isNextButtonToPress then
            alternate = not alternate
            if alternate then
                targetPart = activeButton
            else
                targetPart = activeNextButton
            end
        elseif isButtonToPress then
            targetPart = activeButton
        elseif isNextButtonToPress then
            targetPart = activeNextButton
        else
            targetPart = GetTargetPart()
        end

        if targetPart then
            HRP.Anchored = false
            
            if Camera.CameraSubject ~= Hum then
                Camera.CameraSubject = Hum
            end

            if Escaped then break end

            HRP.CFrame = CFrame.new(targetPart.Position)
            HRP.Velocity = Vector3.zero

            if isButtonToPress or isNextButtonToPress then
                escapeTimer = nil 
                
                if activeButton == lastButtonInstance then
                    if not buttonStuckTimer then
                        buttonStuckTimer = os.time()
                    elseif os.time() - buttonStuckTimer > 15 then
                        Alert("Stuck on group button/glitched button (>15s). Force resetting...", "Error")
                        local char = GetChar()
                        local humObj = char and char:FindFirstChildOfClass("Humanoid")
                        if humObj then humObj.Health = 0 end
                        break
                    end
                else
                    lastButtonInstance = activeButton
                    buttonStuckTimer = nil
                end

                if isButtonToPress then
                    PressedMapButton:FireServer(activeButton)
                end
                if isNextButtonToPress then
                    PressedMapButton:FireServer(activeNextButton)
                end
                task.wait()
            else
                -- == ESCAPE/EXIT PHASE ==
                ExitPhaseActive = true -- Safely authorize exit alerts to process
                buttonStuckTimer = nil 
                
                if not escapeTimer then
                    escapeTimer = os.time()
                elseif os.time() - escapeTimer > 10 then
                    Alert("Escape phase exceeded 10 seconds! Force resetting character to prevent lock.", "Error")
                    local char = GetChar()
                    local humObj = char and char:FindFirstChildOfClass("Humanoid")
                    if humObj then
                        humObj.Health = 0
                    end
                    break
                end

                -- Handle Exit Region dynamically bypassing specific variable names
                if CachedUpdGameState and debug_setupvalue then
                    -- Unlock all boolean states (bypasses escape lock debounce dynamically)
                    for _, idx in ipairs(CachedEscapeLockIndices) do
                        pcall(debug_setupvalue, CachedUpdGameState, idx, false)
                    end
                    
                    -- Fire the escape remote using the globally cached static passkey
                    if _G.ServerPasskey then
                        SurvivedRemote:FireServer(_G.ServerPasskey, 100)
                    end
                end
                
                task.wait()
            end
        else
            task.wait()
        end
    end
    
    if Camera.CameraSubject ~= Humanoid then
        Camera.CameraSubject = Humanoid
    end
    SetNoclip(false)
    
    if Escaped then
        if spawnCFrame and HRP then
            HRP.CFrame = spawnCFrame
            HRP.Velocity = Vector3.zero
        end
        Alert("Escaped successfully! (Credit: tomatotxt on discord)", "Success")
        
        -- Auto Rebirth logic (Uses globally cached static passkey + static remote constant)
        if UI_State.AutoRebirth then
            if _G.ReqRebirth then
                Alert("Attempting Auto Rebirth...", "Info")
                
                if _G.ServerPasskey then
                    pcall(function()
                        _G.ReqRebirth:FireServer(_G.ServerPasskey)
                        Alert("Auto Rebirth request sent successfully!", "Success")
                    end)
                else
                    Alert("Failed to attempt Auto Rebirth: Static passkey was not resolved at startup.", "Error")
                end
            else
                Alert("Failed to attempt Auto Rebirth: Global Rebirth Remote missing.", "Warning")
            end
        end
        
        if UI_State.ResetAfterEscape then
            task.wait(1)
            local char = GetChar()
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.Health = 0
            end
        end
    else
        Alert("Map beat or terminated.", "Info")
    end
    
    -- Only disconnect GodMode if ResetAfterEscape is set to true.
    -- If false, your GodMode stays fully active in the lobby!
    if CurrentGodModeConnection and UI_State.ResetAfterEscape then 
        CurrentGodModeConnection:Disconnect() 
        CurrentGodModeConnection = nil
    end
    
    Alert("Waiting in lobby for the next round...", "System")
    ExitPhaseActive = false -- Reset exit phase flag
    CurrentlyFarming = false
end


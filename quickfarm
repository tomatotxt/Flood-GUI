local function GetTargetPart()
    local goal = CurrentGoal
    if not goal then return nil end
    
    if type(goal) == "table" then
        local closestPart = nil
        local minDistance = math.huge
        local char = GetChar()
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        
        if hrp then
            for _, part in pairs(goal) do
                local resolved = ResolveToInstance(part)
                if resolved and resolved:IsA("BasePart") then
                    local offset = hrp.Position - resolved.Position
                    local dist = offset.X * offset.X + offset.Y * offset.Y + offset.Z * offset.Z
                    if dist < minDistance then
                        minDistance = dist
                        closestPart = resolved
                    end
                end
            end
        end
        return closestPart
    else
        local resolved = ResolveToInstance(goal)
        if resolved and resolved:IsA("BasePart") then
            return resolved
        end
    end
    return nil
end

local function GetCurrentMapDifficulty()
    local success, result = pcall(function()
        local lobby = Workspace:FindFirstChild("Lobby")
        local gameInfo = lobby and lobby:FindFirstChild("GameInfo")
        local surfaceGui = gameInfo and gameInfo:FindFirstChild("SurfaceGui")
        local frame = surfaceGui and surfaceGui:FindFirstChild("Frame")
        local difficultyLabel = frame and frame:FindFirstChild("Difficulty") and frame.Difficulty:FindFirstChild("Difficulty")
        if difficultyLabel then
            local text = difficultyLabel.Text
            return text:split(":")[1]:gsub("^%s*(.-)%s*$", "%1")
        end
    end)
    return success and result or nil
end


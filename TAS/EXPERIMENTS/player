-- // CLEANUP FUNCTION //
local CleanedUp = false
local function Cleanup(resetCharacter)
    if CleanedUp then return end
    CleanedUp = true
    getgenv().IsTASPlaying = false
    Alert("Cleaning Up TAS Engine...", Color3.fromRGB(255, 100, 100))
    
    pcall(function() toggleSlide(false) end)
    pcall(function() toggleSwing(false) end)
    pcall(function() if HUD and HUD.ScreenGui then HUD.ScreenGui:Destroy() end end)
    
    for _, connection in pairs(getgenv().TASConnections) do connection:Disconnect() end
    getgenv().TASConnections = {}

    if LP.Character then
        local antiClip = LP.Character:FindFirstChild("CL_AntiSideClip")
        local airMom = LP.Character:FindFirstChild("CL_AirMomentum")
        if antiClip then antiClip.Disabled = false end
        if airMom then airMom.Disabled = false end
    end

    if resetCharacter and LP.Character and LP.Character:FindFirstChild("Humanoid") then
        LP.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Dead)
        LP.Character.Humanoid.Health = 0
    end
end

if LP.Character then
    AddConnection(LP.Character:WaitForChild("Humanoid").Died:Connect(function() Cleanup(false) end))
end


Alert("Executing TAS! (Perfect Sync)", Color3.fromRGB(0, 255, 0))

local PlaybackFrame = 1
local FinishedRun = false

-- // SEPARATE HUD UPDATE LOOP (RenderStepped) //
AddConnection(RS.RenderStepped:Connect(function()
    if not HUD or not HUD.ScreenGui or not HUD.ScreenGui.Parent or FinishedRun then return end
    pcall(function()
        local Elapsed = math.max(0, (os.clock() - MapStartTime) * TimeModifier)
        local progress = math.clamp(PlaybackFrame / math.max(1, totalFrames), 0, 1)
        local m = math.floor(Elapsed / 60)
        local s = math.floor(Elapsed % 60)
        local ms = math.floor((Elapsed * 1000) % 1000)
        
        HUD.TimeLabel.Text = string.format("Time: %d:%02d.%03d", m, s, ms)
        HUD.FrameLabel.Text = string.format("Frame: %d / %d (%.1f%%)", PlaybackFrame, totalFrames, progress * 100)
        
        local FA = TAS_Frames[PlaybackFrame]
        local animName = (FA and FA.Animation and FA.Animation[1]) or "none"
        local animSpeed = (FA and FA.Animation and FA.Animation[2]) or 0
        HUD.AnimLabel.Text = string.format("Anim: %s (%.2fx)", animName, animSpeed)
        
        HUD.BarFill.Size = UDim2.new(progress, 0, 1, 0)
    end)
end))

-- // PRESIMULATION PHYSICS LOOP //
local MainLoop = RS.PreSimulation:Connect(function()
    if CleanedUp then return end
    
    local Char = LP.Character
    local Root = Char and Char:FindFirstChild("HumanoidRootPart")
    local Hum = Char and Char:FindFirstChild("Humanoid")
    if not Root or not Hum then return end 

    Hum.AutoRotate = false

    local Elapsed = (os.clock() - MapStartTime) * TimeModifier
    
    while PlaybackFrame < totalFrames and TAS_Frames[PlaybackFrame + 1].Time <= Elapsed do 
        PlaybackFrame += 1 
    end

    if PlaybackFrame >= totalFrames then
        if not FinishedRun then
            FinishedRun = true
            Alert('TAS Finished Successfully!', Color3.new(0, 1, 0))
            Cleanup(false) 
        end
        return
    end

    local FA = TAS_Frames[PlaybackFrame]
    local FB = TAS_Frames[PlaybackFrame + 1] or FA

    local Dur = FB.Time - FA.Time
    local Alpha = (Dur > 0) and math.clamp((Elapsed - FA.Time) / Dur, 0, 1) or 0

    local targetCF = FA.CFrame:Lerp(FB.CFrame, Alpha)
    local targetLinVel = FA.Velocity:Lerp(FB.Velocity, Alpha)

    -- Dynamic MoveDirection spoofing
    if targetLinVel.Magnitude > 0 then
        getgenv().TASCurrentMoveDir = targetLinVel.Unit
    else
        getgenv().TASCurrentMoveDir = Vector3.new(0,0,0)
    end

    -- INJECT PHYSICS
    Root.CFrame = targetCF + Offset
    Root.AssemblyLinearVelocity = targetLinVel
    Hum.Health = 99999 -- Godmode

    -- Play Animations & Sync Mechanics
    pcall(activateAnimation, FA.Animation)
end)
AddConnection(MainLoop)

-- // QUATERNION TO CFRAME MATRICES //
local function QuaternionToCFrame(pos, qx, qy, qz, qw)
    local xx = qx * qx; local yy = qy * qy; local zz = qz * qz
    local xy = qx * qy; local xz = qx * qz; local xw = qx * qw
    local yz = qy * qz; local yw = qy * qw; local zw = qz * qw
    
    local r00 = 1 - 2 * (yy + zz)
    local r01 = 2 * (xy - zw)
    local r02 = 2 * (xz + yw)
    
    local r10 = 2 * (xy + zw)
    local r11 = 1 - 2 * (xx + zz)
    local r12 = 2 * (yz - xw)
    
    local r20 = 2 * (xz - yw)
    local r21 = 2 * (yz + xw)
    local r22 = 1 - 2 * (xx + yy)
    
    return CFrame.new(pos.X, pos.Y, pos.Z, r00, r01, r02, r10, r11, r12, r20, r21, r22)
end

-- // NATIVE LUAU BUFFER DESERIALIZER //
local BufferReader = {}
BufferReader.__index = BufferReader

function BufferReader.new(buf)
    return setmetatable({ Buf = buf, Pos = 0 }, BufferReader)
end
function BufferReader:ReadU8() local v = buffer.readu8(self.Buf, self.Pos); self.Pos += 1; return v end
function BufferReader:ReadU16() local v = buffer.readu16(self.Buf, self.Pos); self.Pos += 2; return v end
function BufferReader:ReadU32() local v = buffer.readu32(self.Buf, self.Pos); self.Pos += 4; return v end
function BufferReader:ReadF32() local v = buffer.readf32(self.Buf, self.Pos); self.Pos += 4; return v end
function BufferReader:ReadF64() local v = buffer.readf64(self.Buf, self.Pos); self.Pos += 8; return v end
function BufferReader:ReadString()
    local len = self:ReadU16()
    local str = buffer.readstring(self.Buf, self.Pos, len)
    self.Pos += len; return str
end
function BufferReader:ReadVector3() return Vector3.new(self:ReadF32(), self:ReadF32(), self:ReadF32()) end
function BufferReader:ReadCFrame()
    local pos = self:ReadVector3()
    local qx, qy, qz, qw = self:ReadF32(), self:ReadF32(), self:ReadF32(), self:ReadF32()
    return QuaternionToCFrame(pos, qx, qy, qz, qw)
end


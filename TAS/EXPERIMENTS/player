local LastPlayedAnim = nil
local IsSliding = false
local IsSwinging = false

-- SLIDE TOGGLE
toggleSlide = function(newValue)
    local char = LP.Character
    if not char then return end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    local hb = char:FindFirstChild("FE2_Hitbox")
    local animate = char:FindFirstChild("Animate")

    if newValue then
        if root then root.Size = Vector3.new(2, 1, 1) end
        if hb then hb.Size = Vector3.new(2, 1, 1) end
        if hum then hum.HipHeight = -1.5 end
        
        if animate and animate:FindFirstChild("Sliding") then
            pcall(function() animate.Sliding:Fire(true) end)
        end
        if root and root:FindFirstChild("SlideParticles") then
            root.SlideParticles.Enabled = true
        end
    else
        if root then root.Size = Vector3.new(2, 2, 1) end
        if hb then hb.Size = Vector3.new(2, 2, 1) end
        if hum then hum.HipHeight = 0 end
        
        if animate and animate:FindFirstChild("Sliding") then
            pcall(function() animate.Sliding:Fire(false) end)
        end
        if root and root:FindFirstChild("SlideParticles") then
            root.SlideParticles.Enabled = false
        end
    end
end

-- SWING / ZIPLINE TOGGLE
toggleSwing = function(newValue)
    local char = LP.Character
    if not char then return end
    
    local hum = char:FindFirstChild("Humanoid")
    local animate = char:FindFirstChild("Animate")

    if newValue then
        if hum then
            hum:ChangeState(Enum.HumanoidStateType.Physics)
        end
        if animate and animate:FindFirstChild("Swinging") then
            pcall(function() animate.Swinging:Fire(true) end)
        end
    else
        if animate and animate:FindFirstChild("Swinging") then
            pcall(function() animate.Swinging:Fire(false) end)
        end
    end
end

local function activateAnimation(AnimData)
    if not AnimData then return end
    local n = AnimData[1]
    local animTime = AnimData[2] or 0.1

    -- 1. Slide Mechanics Sync
    if n == "slide" then
        if not IsSliding then 
            toggleSlide(true)
            IsSliding = true 
        end
    else
        if IsSliding then 
            toggleSlide(false)
            IsSliding = false 
        end
    end

    -- 2. Swing / Zipline Mechanics Sync
    if n == "swing" or n == "zipline" then
        if not IsSwinging then
            toggleSwing(true)
            IsSwinging = true
        end
    else
        if IsSwinging then
            toggleSwing(false)
            IsSwinging = false
        end
    end

    -- 3. Play Animation Track ONLY if the track changed
    if n and n ~= LastPlayedAnim then
        if OriginalPlayAnim then
            OriginalPlayAnim(n, animTime, Humanoid)
            if n == "walk" and AnimateEnv and AnimateEnv.setAnimationSpeed then 
                AnimateEnv.setAnimationSpeed(0.76) 
            end
        end
        LastPlayedAnim = n
    end
end


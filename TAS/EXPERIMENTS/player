-- // STRICT MAP DETECTION SYSTEM //
-- ========================================================
local LiftCheckPos = Vector3.new(-25, -144, 139)
local MapModel = nil

while not MapModel and not CleanedUp do
    local InZone = false
    repeat
        task.wait(0.1)
        local Root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if Root then
            local Dist = (Root.Position - LiftCheckPos).Magnitude
            if Dist <= 30 or Dist > 800 then InZone = true end
        end
    until InZone or CleanedUp
    
    if CleanedUp then return end
    Alert("Ready! Waiting for New Map...", Color3.fromRGB(0, 255, 255))
    
    while InZone and not CleanedUp do
        local Root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if Root then
            local Dist = (Root.Position - LiftCheckPos).Magnitude
            if Dist > 30 and Dist <= 800 then
                InZone = false
                Alert("Left Zone - Pausing...", Color3.fromRGB(255, 100, 0))
                break
            end
        end
        
        -- STRICTLY wait for NewMap so we don't accidentally attach to an old map from a previous round
        local FoundMap = Workspace.Multiplayer:FindFirstChild("NewMap")
        if FoundMap then 
            MapModel = FoundMap
            warn("[TAS V5.6] Detected 'NewMap' incoming from server!")
            break 
        end
        task.wait(0.1)
    end
end

if CleanedUp or not MapModel then return end

-- Wait for FE2 to finish loading and rename "NewMap" to "Map"
Alert("NewMap Found! Waiting for initialization...", Color3.fromRGB(0, 255, 255))
repeat task.wait() until MapModel.Name == "Map" or CleanedUp
if CleanedUp then return end
warn("[TAS V5.6] Map fully initialized and renamed to 'Map'.")

-- // RESOLVE EXACT MAP OFFSET //
local MapAnchor = MapModel:FindFirstChild("Spawn", true)

if not MapAnchor then
    local target = nil
    local connections = {}
    for _, child in ipairs(MapModel:GetChildren()) do
        if child.Name == "Part" and child.Size.Y < 5 then
            table.insert(connections, child:GetPropertyChangedSignal("Rotation"):Connect(function() target = child end))
        end
    end
    local t = 0
    while not target and t < 50 do task.wait(0.1); t += 1 end
    for _, con in ipairs(connections) do con:Disconnect() end
    MapAnchor = target
end

local Offset = Vector3.new(0,0,0)
if MapAnchor then
    Offset = MapAnchor.Position - Vector3.new(0, 1000, 0)
else
    warn("[TAS V5.6] FATAL: Could not resolve Map Anchor!")
end

-- // READ BINARY BUFFER (.fe2tomatas) //
local rawMapName = MapModel:WaitForChild("Settings"):GetAttribute("MapName") or "Unknown_Map"
local cleanName = rawMapName:gsub("[^%w_]", "")
local filename = "FE2_TAS_Runs/" .. cleanName .. ".fe2tomatas"

if not readfile or not isfile(filename) then
    Alert("LOCAL TAS FILE MISSING! Expected: " .. filename, Color3.new(1,0,0))
    Cleanup(true)
    return
end

local fileContent = readfile(filename)
local binaryBuf = buffer.fromstring(fileContent)
local Reader = BufferReader.new(binaryBuf)

-- Verify Header Magic
local magic = buffer.readstring(binaryBuf, 0, 4); Reader.Pos += 4
if magic ~= "FE2T" then
    Alert("Invalid Binary File Magic! (Expected FE2T)", Color3.new(1,0,0))
    Cleanup(true)
    return
end

local version = Reader:ReadU8()
local targetFPS = Reader:ReadU8()
local totalFrames = Reader:ReadU32()
local creator = Reader:ReadString()
local recordedMapName = Reader:ReadString()

warn(string.format("[TAS V5.6] Header Valid -> Creator: %s | Total Frames: %d", creator, totalFrames))

local TAS_Frames = table.create(totalFrames)

local decodeSuccess, decodeErr = pcall(function()
    for i = 1, totalFrames do
        local time = Reader:ReadF64()
        local vel = Reader:ReadVector3()
        local cf = Reader:ReadCFrame()
        local camCf = Reader:ReadCFrame()
        local animSpeed = Reader:ReadF32()
        local animName = Reader:ReadString()
        
        TAS_Frames[i] = {
            Time = time,
            Velocity = vel,
            CFrame = cf,
            CameraCFrame = camCf,
            Animation = {animName, animSpeed}
        }
    end
end)

if not decodeSuccess or #TAS_Frames == 0 then
    warn("[TAS V5.6] DECODE ERROR:", decodeErr)
    Alert("Failed to decode binary frames!", Color3.new(1,0,0))
    Cleanup(true)
    return
end

Alert(string.format("Loaded Local TAS! Frames: %d", #TAS_Frames), Color3.new(0,1,1))

